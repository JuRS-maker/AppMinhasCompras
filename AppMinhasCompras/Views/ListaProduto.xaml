<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppMinhasCompras.Views.ListaProduto"
             Title="ListaProduto">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Somar" Clicked="ToolbarItem_Clicked_1"/>
        <ToolbarItem Text="Adicionar" Clicked="ToolbarItem_Clicked" />    
    </ContentPage.ToolbarItems>

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style TargetType="Label">
                <Setter Property="VerticalTextAlignment" Value="Center" />
                <Setter Property="TextColor" Value="Black" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <StackLayout>
        <SearchBar x:Name="txt_search" 
                   Margin="-15, 0, 0, 0"
                   Placeholder="Busca de Produtos" 
                   TextChanged="txt_search_TextChanged"/>

        <HorizontalStackLayout Margin="10,5" Spacing="10">
            <Label Text="Filtrar por Categoria:" VerticalOptions="Center"/>
            <Picker x:Name="pck_categoria"
                    Title="Todas"
                    HorizontalOptions="FillAndExpand"
                    SelectedIndexChanged="pck_categoria_SelectedIndexChanged"/>
        </HorizontalStackLayout>

        <Frame Padding="0" Margin="10" VerticalOptions="FillAndExpand">
            <ListView x:Name="lst_produtos" 
                  IsPullToRefreshEnabled="True"
                  Refreshing="lst_produtos_Refreshing"
                  ItemSelected="lst_produtos_ItemSelected">

                <ListView.Header>
                    <Grid ColumnDefinitions="25, *, 60, 35, 70, 70"
                          BackgroundColor="{StaticResource Gray100}">
                        <Label Grid.Column="0" Text="ID" Padding="2"/>
                        <Label Grid.Column="1" Text="Descrição" Padding="2"/>
                        <Label Grid.Column="2" Text="Preço" Padding="2"/>
                        <Label Grid.Column="3" Text="Qtd" Padding="2"/>
                        <Label Grid.Column="4" Text="Categoria" Padding="2"/>
                        <Label Grid.Column="5" Text="Total" Padding="2"/>
                    </Grid>
                </ListView.Header>

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <ViewCell.ContextActions>
                                <MenuItem Text="Remover" Clicked="MenuItem_Clicked"/>
                            </ViewCell.ContextActions>
                            <Grid ColumnDefinitions="25, *, 60, 35, 70, 70">
                                <Label Grid.Column="0" Text="{Binding Id}" Padding="2"/>
                                <Label Grid.Column="1" Text="{Binding Descricao}" Padding="2"/>
                                <Label Grid.Column="2" Text="{Binding Preco, StringFormat='{}{0:c}'}" Padding="2" />
                                <Label Grid.Column="3" Text="{Binding Quantidade}" Padding="2"/>
                                <Label Grid.Column="4" Text="{Binding Categoria}" Padding="2"/>
                                <Label Grid.Column="5" Text="{Binding Total, StringFormat='{}{0:c}'}" Padding="2" />
                            </Grid>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Frame>
        
    </StackLayout>
</ContentPage>